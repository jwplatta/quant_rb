#!/usr/bin/env bash


set -e  # Exit on any error

echo "Building options_trader gem..."

gem build options_trader.gemspec

mkdir -p pkg

mv options_trader-*.gem pkg/

GEM_FILE=$(ls pkg/options_trader-*.gem | head -n1)

echo "Installing gem: $GEM_FILE"

gem install "$GEM_FILE"

echo "Successfully installed options_trader gem!"