# Database Configuration for Supabase
DATABASE_HOST=aws-0-us-east-2.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_USER=postgres.user
DATABASE_PASSWORD=your_supabase_password_here
DATABASE_NAME=your_database_name_here

# Schwab API Configuration
SCHWAB_CLIENT_ID=your_schwab_client_id
SCHWAB_CLIENT_SECRET=your_schwab_client_secret
SCHWAB_REDIRECT_URI=https://localhost:8080
SCHWAB_TOKEN_PATH=tmp/schwab_tokens.json

# Account Configuration
SCHWAB_ACCOUNT=your_account_number